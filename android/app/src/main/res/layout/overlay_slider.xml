<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gv_overlay_root"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="12dp"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:background="@drawable/bg_pill_overlay"
    android:elevation="20dp">

    <!-- Close — small, at the TOP so it stays reachable even when the pill is
         tucked low against the bottom edge (away from the home gesture zone). -->
    <ImageButton
        android:id="@+id/gv_btn_dismiss"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_overlay_close"
        android:src="@drawable/ic_close"
        android:tint="#B3FFFFFF"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/gv_dismiss" />

    <!-- Drag handle — grab anywhere on the pill to reposition; this is the visual cue.
         When the pill is collapsed to a bottom tab, the handle + close above stay visible. -->
    <View
        android:id="@+id/gv_drag_handle"
        android:layout_width="26dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@string/gv_drag_handle" />

    <!-- Collapsible body: hidden when the pill is tucked into the bottom tab. -->
    <LinearLayout
        android:id="@+id/gv_collapsible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Louder: one step up the combined full-range scale.
             1.4.4 option B "Sculpted Glass": wide stadium key, 48x30. The 10dp saved
             versus the old 40dp-tall chevron is spent as 2+2dp margins here (and on the
             down key) so the pill's OUTER envelope does not move — the tuned tuck-to-edge
             geometry is a locked constraint. -->
        <ImageButton
            android:id="@+id/gv_btn_up"
            android:layout_width="48dp"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_glass_key"
            android:src="@drawable/ic_chevron_up"
            android:tint="#F2F4FF"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/gv_louder" />

        <!-- UPPER ZONE: normal system volume, replaces the physical buttons.
             Bars are created dynamically — their count is the device's real 5 dB rung
             count (media) or its hardware step count (ring / fallback), so the container
             height is FIXED and only bar density varies (no-growth size cap). -->
        <LinearLayout
            android:id="@+id/gv_upper_container"
            android:layout_width="48dp"
            android:layout_height="84dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="2dp" />

        <!-- The device-minimum line: everything below it is territory the hardware
             cannot reach. The visual centerpiece of full-range mode. -->
        <View
            android:id="@+id/gv_divider"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:background="#FF9800"
            android:contentDescription="@string/gv_divider_desc" />

        <!-- One-time hint, shown on first overlay display only, gone on first touch. -->
        <TextView
            android:id="@+id/gv_line_tooltip"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="@string/gv_line_tooltip"
            android:textColor="#FFB74D"
            android:textSize="8sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- QUIET ZONE: 7 discrete dB step bars, behaviourally identical to the
             existing product. Arranged top → bottom = loudest → quietest:
             gv_step_bar_6 = 0 dB (at the device floor), gv_step_bar_0 = -30 dB -->
        <LinearLayout
            android:id="@+id/gv_steps_container"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp">

            <!-- step 6 = 0 dB attenuation = the device floor.
                 HIDDEN ON PURPOSE: after the seam fix the LAST rung of the upper zone is
                 already exactly this loudness (hardware at min index, no gain). Rendering
                 both meant two bars for one level, which forced the chevrons to skip a bar
                 on every crossing — audibly right, visually wrong. One loudness, one bar.
                 The quiet zone is "below the minimum", so a "zero below the minimum" bar
                 was redundant to begin with. Kept in the layout (not deleted) because
                 STEP_DB index 6 still exists and the Pro gate math is indexed against it. -->
            <View
                android:id="@+id/gv_step_bar_6"
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_step_bar"
                android:visibility="gone"
                android:contentDescription="@string/gv_step_label_0db" />

            <!-- step 5 = -5 dB -->
            <View
                android:id="@+id/gv_step_bar_5"
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_step_bar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/gv_step_label_5db" />

            <!-- step 4 = -10 dB -->
            <View
                android:id="@+id/gv_step_bar_4"
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_step_bar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/gv_step_label_10db" />

            <!-- step 3 = -15 dB -->
            <View
                android:id="@+id/gv_step_bar_3"
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_step_bar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/gv_step_label_15db" />

            <!-- step 2 = -20 dB -->
            <View
                android:id="@+id/gv_step_bar_2"
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_step_bar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/gv_step_label_20db" />

            <!-- step 1 = -25 dB -->
            <View
                android:id="@+id/gv_step_bar_1"
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_step_bar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/gv_step_label_25db" />

            <!-- step 0 = -30 dB -->
            <View
                android:id="@+id/gv_step_bar_0"
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:background="@drawable/bg_step_bar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/gv_step_label_30db" />

        </LinearLayout>

        <!-- Quieter: one step down the combined full-range scale -->
        <ImageButton
            android:id="@+id/gv_btn_down"
            android:layout_width="48dp"
            android:layout_height="30dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_glass_key"
            android:src="@drawable/ic_chevron_down"
            android:tint="#D5D9EC"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/gv_quieter" />

        <!-- 1.4.4 option B bottom block: the dB label centred ABOVE a full-width mute bar.
             Mute is MEDIA-STREAM mute (alarms keep ringing) — the one sanctioned
             path to true silence, always an explicit action, never a slide.
             The bar is deliberately unlike anything else in the pill (shape, position,
             size) so a chevron tap cannot plausibly land on it. -->

        <!-- Percentage above the line, dB below it (locked label spec).
             Mirrors the mute state in colour AND text, so mute is carried by three
             redundant channels: bar colour, glyph, and this label. -->
        <TextView
            android:id="@+id/gv_label_db"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 dB"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:id="@+id/gv_btn_mute"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_mute_bar"
            android:contentDescription="@string/gv_mute">

            <ImageView
                android:id="@+id/gv_mute_glyph"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_volume_off"
                android:tint="#99FFFFFF"
                android:scaleType="centerInside"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/gv_mute_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="@string/gv_mute_bar_label"
                android:textColor="#99FFFFFF"
                android:textSize="7sp"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
