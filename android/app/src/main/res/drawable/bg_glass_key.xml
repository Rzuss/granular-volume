<?xml version="1.0" encoding="utf-8"?>
<!-- 1.4.4 option B "Sculpted Glass" chevron key.
     Stadium shape (radius = half the 30dp height), vertical glass gradient with a soft
     top sheen. Pressed state is driven MANUALLY from OverlayManager.pressPulse() because
     children are non-clickable by design (the unified root touch handler owns all input),
     so the system never sets state_pressed on its own. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7C7CF0" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Glass body -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#1CFFFFFF"
                        android:endColor="#09FFFFFF" />
                    <corners android:radius="15dp" />
                    <stroke android:width="1dp" android:color="#1FFFFFFF" />
                </shape>
            </item>
            <!-- Top highlight: a sheen fading out over the upper half -->
            <item android:bottom="15dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
