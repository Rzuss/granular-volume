<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audio attenuation via AudioEffect global session -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Floating overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground service (required Android 8+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse: the service maintains a real-time audio-attenuation effect + floating
         volume overlay while the user listens to media in other apps. It does not play media
         itself, so it does not fit mediaPlayback; specialUse is the correct category. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Auto-start on boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Post notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GranularVolume">

        <!-- Main entry point — permission setup only, minimal UI -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Open-source notices. Required by the Apache-2.0 licences of the bundled
             libraries, which oblige us to pass on their attribution notices and a copy of
             the licence. Reachable from the main screen at any time. -->
        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="@string/gv_licenses_title" />

        <!-- Full-range paywall (1.5.0). Translucent host for the upgrade sheet, launched
             when a locked gesture is refused. Stays alive (no noHistory) so the buyer
             returning from Google Play lands back on it, where onResume re-checks
             entitlement and tells the service the key arrived. singleTop so a second
             locked tap re-delivers instead of stacking a duplicate sheet. Never launched
             in the F-Droid build, where the full range is free and the gate never fires. -->
        <!-- "Your access" sheet, opened from the dial's info button. Same translucent
             host and sheet theme as the paywall, so both commercial moments look alike. -->
        <activity
            android:name=".InfoSheetActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.GranularVolume.Paywall" />

        <activity
            android:name=".PaywallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.GranularVolume.Paywall" />

        <!-- Foreground service for audio effect + overlay -->
        <service
            android:name=".service.VolumeControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a real-time per-stream audio attenuation effect and a floating volume-control overlay while the user listens to media in other apps." />
        </service>

        <!-- Auto-start after device reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 1.6.2: the two one-time free-week notices, armed by TrialNotices. Own PendingIntents only. -->
        <receiver
            android:name=".receiver.TrialNoticeReceiver"
            android:exported="false" />

        <!-- Quick Settings tile — toggles the overlay on/off from the notification shade -->
        <service
            android:name=".service.GranularVolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
